{
  "scope": "Current verification and explicit canonical method stages; historical application rebuild remains separate.",
  "targets": {
    "verify": {
      "steps": [
        {
          "command": [
            "{python}",
            "-m",
            "pytest",
            "tests/",
            "-q"
          ],
          "requires": [
            "tests"
          ]
        }
      ]
    },
    "methods": {
      "steps": [
        {
          "command": [
            "{python}",
            "scripts/sc_experiment.py",
            "--all",
            "--seeds",
            "3",
            "--epochs",
            "200",
            "--ckpt-dir"
          ],
          "requires": [
            "data/sc/rd.h5",
            "data/sc/ks.h5",
            "data/sc/film.h5",
            "data/sc/burgers.h5",
            "data/sc/sidm.h5"
          ],
          "produces": [
            "results/statecond/ckpt"
          ]
        },
        {
          "command": [
            "{python}",
            "scripts/sc_timehead.py",
            "--all",
            "--seeds",
            "3",
            "--budgets",
            "200",
            "600",
            "2000",
            "6000",
            "20000",
            "--save-heads"
          ],
          "requires": [
            "results/statecond/ckpt"
          ],
          "produces": [
            "results/statecond/timehead.json"
          ]
        },
        {
          "command": [
            "{python}",
            "scripts/sc_direct.py",
            "--all",
            "--seeds",
            "3",
            "--epochs",
            "200"
          ],
          "requires": [
            "results/statecond/ckpt"
          ],
          "produces": [
            "results/statecond/direct.json"
          ]
        },
        {
          "command": [
            "{python}",
            "scripts/sc_contract.py",
            "--all",
            "--seeds",
            "3"
          ],
          "requires": [
            "results/statecond/timehead.json",
            "results/statecond/direct.json"
          ],
          "produces": [
            "results/statecond/contract.json"
          ]
        }
      ]
    },
    "forecast-results": {
      "steps": [
        {
          "command": [
            "{python}",
            "scripts/forecast_validation_audit.py",
            "--device",
            "cpu"
