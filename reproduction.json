    "closure_test": {
      "description": "The conductivity-closure test of the manuscript (Section 4) from the archived particle measurements and fluid grids: ladders, frozen-prediction scores of D1, D2 and E1, E2, the halo B half-step control, the five- and seven-halo fits, robustness, the matched-marker refit, the figures, and the tabulated-closure tests. CPU only; minutes. The particle runs themselves need NSphere (see experiments/research_extensions/README.md).",
      "steps": [
        {
          "command": [
            "{python}",
            "experiments/research_extensions/scripts/multifidelity_analysis.py"
          ],
          "requires": [
            "experiments/research_extensions/multifidelity/nsphere/B_N5e4_s11/measures.npz",
            "results/independent_halo_20261107/nsphere_B1.npz"
          ],
          "produces": [
            "experiments/research_extensions/multifidelity/ladder_analysis.json"
          ]
        },
        {
