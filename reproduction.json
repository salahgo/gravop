          "requires": [
            "results/forecast_validation/execution_provenance.json",
            "results/forecast_validation/application/sidm_full_s0/model.pt",
            "results/forecast_validation/application/sidm_full_s1/model.pt",
            "results/forecast_validation/application/sidm_full_s2/model.pt"
